{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "go build -o rest-api .",
      "options": {
        "cwd": "${workspaceFolder}/11-rest-api"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "go run .",
      "options": {
        "cwd": "${workspaceFolder}/2-essentials/investment-calculator"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$go"
      ]
    }
  ]
}