{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "go build -o collections .",
      "options": {
        "cwd": "${workspaceFolder}/10-goroutines/upgrade-price-calculator"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "go run .",
      "options": {
        "cwd": "${workspaceFolder}/2-essentials/investment-calculator"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$go"
      ]
    }
  ]
}